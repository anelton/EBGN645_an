GAMS 54.3.1  61154be4 Aug 21, 2026          WEX-WEI x86 64bit/MS Windows - 10/23/26 17:53:34 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  set i "parcels" /A, B, C/ ;
   2  set t "years"   /1*2/ ;
   3   
   4  alias (i, j) ;
   5  alias (t, tt) ;
   6   
   7  parameter
   8  wfp(i) "annual prob. a wildfire starts in parcel i"  /A 0.25,   B 0.18,   C 0.15/,
   9  wfd(i) "damage if wildfire affects parcel i"         /A 400000, B 475000, C 600000/,
  10  wfr(i) "reduction in prob. after treatment"          /A 0.90,   B 0.92,   C 0.88/,
  11  c(i)   "cost of treating parcel i"                   /A 25000,  B 40000,  C 35000/,
  12  trd(i) "damage from prescribed burning"              /A 2000,   B 4000,   C 2000/,
  13  mb(t)  "max treatments per year"                     /1 1, 2 1/ ;
  14   
  15  scalar tb "treatment budget across both years" /75000/ ;
  16   
  17  * wfs(j,i): prob. a fire starting in j spreads directly to i (before treatment)
  18  table wfs(j,i)
  19          A       B       C
  20  A               0.45    0.30
  21  B       0.40            0.35
  22  C       0.35    0.35          ;
  23   
  24  * total prob. parcel i is affected: own ignition + fire spreading in from j
  25  parameter pa(i) "total prob. parcel i is affected by wildfire" ;
  26  pa(i) = wfp(i) + sum(j$wfs(j,i), wfp(j) * wfs(j,i)) ;
  27   
  28  binary variable X(i,t) "1 if parcel i is treated in year t" ;
  29  positive variable Y(i,t) "1 if parcel i treated in current or prior year" ;
  30  variable TC "total costs" ;
  31   
  32  equation objfn, budget, maxtreat(t), once(i), track(i,t) ;
  33   
  34  objfn.. TC =e=
  35      sum((i,t), pa(i) * (1 - wfr(i) * Y(i,t)) * wfd(i))
  36    + sum((i,t), (c(i) + trd(i)) * X(i,t)) ;
  37   
  38  budget..      tb =g= sum((i,t), c(i) * X(i,t)) ;
  39  maxtreat(t).. mb(t) =g= sum(i, X(i,t)) ;
  40  once(i)..     sum(t, X(i,t)) =l= 1 ;
  41  track(i,t)..  Y(i,t) =e= sum(tt$(ord(tt) <= ord(t)), X(i,tt)) ;
  42   
  43  model wildfire /all/ ;
  44  option optcr = 0 ;
  45   
  46  solve wildfire using MIP minimizing TC ;
  47  parameter rep ;
  48  rep("Baseline","X",i,t) = X.l(i,t) ;
  49  rep("Baseline","Y",i,t) = Y.l(i,t) ;
  50  rep("Baseline","TC","total","-") = TC.l ;
  51   
  52  execute_unload 'alldata_wildfire.gdx' ;
  53   
  54   
  55   
  56  * example scenario: allow two treatments per year
  57  mb(t) = 2 ;
  58   
  59  solve wildfire using MIP minimizing TC ;
  60  rep("Double Treatment","X",i,t) = X.l(i,t) ;
  61  rep("Double Treatment","Y",i,t) = Y.l(i,t) ;
  62  rep("Double Treatment","TC","total","-") = TC.l ;
  63   
  64  display pa, rep ;
  65   
  66  execute_unload 'alldata_wildfire.gdx' ;


